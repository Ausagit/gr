#class {bot} {open}

#var {no_loop} {1}
#var {no_home} {1}
#var {hardmode} {1}
#var {vacuum} {0}

#variable {botpath} {n;e;e;e}

#action {^=M= {rat|large rat}} {
	#switch {"%1"} {
		#case {"rat"}		{#var mobname rat};
		#case {"large rat"}	{#var mobname large rat};
	};
	_check_mob;
}

#class {bot} {close}
