#nop onkill.tin
/* 
	On kill action
	onk				- show your on kill action
	onk clear		- clear your onkill action
	onk <action>	- repeated every round until turned off
	onk1 <action>	- fires once on the next kill then is cleared

	Multiple commands can be added using the / seperator
	Multiple onkills can be nested with the // seperator
	Colons can be inserted by surrounding the argument with braces, e.g. onk {gs;mywho}
	Script can be injected with the following substitutions:
		$variable = $:variable
		"string"  = 'string'
		@function = @:function
	
	Example: onk1 .stop/cdb 100 .resume
*/

#class onkill kill
#class onkill open

#variable onkill_module 1
#variable onkill {}
#variable onkill_os 0

#alias {onk} {
	#if {"%0" == ""} {
		#if {"$onkill" == ""} {
			#echo {<fca>You have no onkill command.<088>}
		} {
			#if {$onkill_os} {
				#echo {<fca>Onkill oneshot is set to %s.<088>} {$onkill}
			} {
				#echo {<fca>Onkill is set to %s.<088>} {$onkill}
			}
		}
	}; #elseif {"%0" == "clear"} {
		#variable {onkill} {};
		#variable {onkill_os} {0};
		#echo {<fca>Onkill cleared.<088>}
	}; #else {
        #variable onkill %0;
		#variable {onkill_os} {0};
		#echo {<fca>Onkill set to %s.<088>} {$onkill}
	}
}
#alias {onk1} {
	#if {"%0" == ""} {
        #if {"$onkill" == ""} {
			#echo {<fca>You have no onkill command.<088>}
		} {
            #if {$onkill_os} {
                #echo {<fca>Onkill oneshot is set to %s.<088>} {$onkill}
            } {
                #echo {<fca>Onkill is set to %s.<088>} {$onkill}
            }
        }
	}; #elseif {"%0" == "clear"} {
		#variable {onkill} {};
		#variable {onkill_os} {0};
		#echo {<fca>Onkill cleared.<088>}		
	}; #else {
        #variable onkill %0;
        #variable {onkill_os} {1};
        #echo {<fca>Onkill oneshot is set to %s.<088>} {$onkill}
    }
}

#alias {onkillrun} {
    #if {"$onkill" != ""} {
		#local lexec {};
		#local exec {};

		#regexp {$onkill} {%*//%*} {
			#nop nested onkills, execute the first arg, onkill the second;
			#variable lexec {&1};
			#variable onkill {&2};
			#variable onkill_os 1
		} {
			#nop regular one-off onkill;
			#variable lexec {$onkill};
			#if {$onkill_os} {
            	#variable onkill {};
            	#variable onkill_os 0
			}
		};

		#nop substitute tokens for scripting;
		#replace {lexec} {'} {"};
    	#replace {lexec} {$:} {$};
    	#replace {lexec} {@:} {@};

		#nop execute each command;
		#list lexec explode {/};	
		#foreach {$lexec[]} {exec} {
			$exec
		}	
    }
}

#function {onkill_format} {
	#local onkf {$onkill};
	#replace onkf {\/\/} {<bbb>//<088>};
	#variable result {$onkf}
}

#class {onkill} {close}
