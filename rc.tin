#CONFIG           {AUTO TAB}		{5000}
#CONFIG           {BUFFER SIZE}		{10000}
#CONFIG           {CHARSET}		    {UTF-8}
#CONFIG           {COLOR MODE}		{TRUE}
#CONFIG           {COLOR PATCH}		{ON}
#CONFIG           {COMMAND COLOR}	{<078>}
#CONFIG           {COMMAND ECHO}	{ON}
#CONFIG           {CONNECT RETRY}	{15}
#CONFIG           {HISTORY SIZE}	{1000}
#CONFIG           {LOG MODE}		{RAW}
#CONFIG           {MOUSE}		    {ON}
#CONFIG           {PACKET PATCH}	{0.3}
#CONFIG           {REPEAT CHAR}		{!}
#CONFIG           {REPEAT ENTER}	{ON}
#CONFIG           {SCROLL LOCK}		{ON}
#CONFIG           {SPEEDWALK}		{OFF}
#CONFIG           {TINTIN CHAR}		{#}
#CONFIG           {VERBATIM}		{OFF}
#CONFIG           {VERBATIM CHAR}	{\}
#CONFIG           {VERBOSE}		    {OFF}
#CONFIG           {WORDWRAP}		{ON}
#PATHDIR          {d}	{u}	{32}
#PATHDIR          {e}	{w}	{2}
#PATHDIR          {n}	{s}	{1}
#PATHDIR          {ne}	{sw}	{3}
#PATHDIR          {nw}	{se}	{9}
#PATHDIR          {s}	{n}	{4}
#PATHDIR          {se}	{nw}	{6}
#PATHDIR          {sw}	{ne}	{12}
#PATHDIR          {u}	{d}	{16}
#PATHDIR          {w}	{e}	{8}

#variable ses_name {};
#variable account_name {};

#EVENT {SESSION CONNECTED} {
    #nop character name not known when first connecting;
}

/* Character Switching */
#alias {switchto} {
        #zap;
        connect %0
}

#alias {connect} {
    #regexp {%0} {%*,%*} {
        #nop account_name,character_name;
        #session {%0} {159.203.54.126} {3000};
        #variable account_name {&1};
        #send $account_name;
        #textin gr/.pass;
        #send &2;
    } {
        #nop just the account name;
        #session {%0} {159.203.54.126} {3000};
        #variable account_name {%0};
        $account_name;
        #textin gr/.pass;
    }   
}

#alias {connect2} {
    #regexp {%0} {%*,%*} {
        #nop account_name,character_name;
        #session {%0} {localhost} {4242};
        #variable account_name {&1};
        #send $account_name;
        #textin gr/.pass;
        #send &2;
    } {
        #nop just the account name;
        #session {%0} {localhost} {4242};
        #variable account_name {%0};
        #send $account_name;
        #textin gr/.pass;
    }   
}

#action {^Gloomrest welcomes you %*, %*!} {
    #format ses_name {%l} {%2};
    #format logfile {gr/logs/${ses_name}_%t.log} {%Y%m%d};
	#LOG {APPEND} {$logfile};
    
	#read gr/start.tin;
    #read gr/char/$ses_name.tin;
    _gset_load;
    
    #delay 1 {
        #if {$watchdog_module} {startwatchdog};
		#nop sg load;
		#if {@alias_exists{on_login}} {on_login}
        rs;
	};

    #delay 2 #send !clientskilllist;
}
