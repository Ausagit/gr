#nop #CLASS {vars} OPEN

#class botvar kill
#read gr/vars/bots.var

#class chat kill
#read gr/vars/chat.var

#class drawvar kill
#read gr/vars/draw.var

#class farmvar kill
#read gr/vars/farm.var

#class mapvar kill
#read gr/vars/map.var

#class shopvar kill
#read gr/vars/shop.var

#class pubvar kill
#read gr/vars/pub.var

#event {SESSION DISCONNECTED} {
	#NOP Save Map vnum per $ses_name;
	#map get roomvnum {map[$ses_name][position]};
	#NOP Save Map (updated exits for unpause);
	#nop mapsave;
	#NOP Write var classes;
    #nop #class chat write gr/vars/chat.var;
	#class botvar write gr/vars/bots.var;
	#class farmvar write gr/vars/farm.var;
	#class mapvar write gr/vars/map.var;
	#class pubvar write gr/vars/pub.var;
	#class shopvar write gr/vars/shop.var
}

#nop #CLASS {vars} CLOSE
