#class {gags} {open}

#nop #gag {^$}
#gag {^>$}
#gag {^#-#}

#alias {uhp} {
    #ungag {^CD[};
    #ungag {^HP[};
    #ungag {^BU[};
    #ungag {^EN[};
    #ungag {^MI[};
}

#alias {ghp} {
    #gag {^CD[};
    #gag {^HP[};
    #gag {^BU[};
    #gag {^EN[};
    #gag {^MI[};
}

ghp

#class {gags} {close}