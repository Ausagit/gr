#alias {terrain} {
	#if {"%1" == ""} {
		#map get roomterrain terrain;
	} {
        #if {"$terrains[%1][col]" == ""} {
            #echo {Invalid terrain type %1.};
            #return;
        };
		#variable terrain %1;
		#map set roomterrain %1
	};

    #local rmcol $terrains[%1][col];
    #local rmsym $terrains[%1][sym];
	
	#format {rmsym_len} {%L} {$rmsym};

	#if {"$rmcol" != ""} {
		#map set roomcolor $rmcol
	};
	#if {$rmsym_len > 0} {
		#map set roomsymbol $rmsym
	};

    #unvariable rsym_len;
    #unvariable terrain;
}

#alias {terrainupdaterooms} {
    #local t {};

    #loop 1 5000 {cnt} {
        #map at $cnt {
            #map get roomterrain t;
            #if {"$t" == ""} {
                #echo {Room vnum %d has no terrain.} {$cnt};
            } {
                #if {"$terrains[$t][sym]" == ""} {
                    #echo {Room vnum %d has invalid terrain '$t'.} {$cnt};
                } {
                   #map set roomcolor $terrains[$t][col];
                   #map set roomsymbol $terrains[$t][sym];    
                }
            }
        }
    };
    #nop #echo {$t};
}

#alias {terrains}
{
    #foreach {*terrains[]} {ter} {
        #local sym {$terrains[$ter][sym]};
        #replace sym {\\} {╲};
        #line ignore #showme {$sym ${terrains[$ter][col]}$ter<088>};
    }
}

#alias {terrainupdate} {
    #nop update the terrain information in the file to match the tt++ table;
    #foreach {*terrains[]} {ter} {
        #map terrain {$ter} {$terrains[$ter][sym]};
    };
    #nop update all rooms to match the tt++ table;
    terrainupdaterooms;
}

#class {terrain} {close}
